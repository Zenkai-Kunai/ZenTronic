:root {
    --bg-dark: #1e1e1e;
    --bg-panel: #252526;
    --bg-toolbar: #2d2d2d;
    --border-color: #3f3f46;
    --text-primary: #d4d4d4;
    --text-muted: #858585;
    --accent-color: #007acc;
    --accent-hover: #0098ff;
    --success-color: #28a745;
    --danger-color: #dc3545;
    --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body, html {
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: var(--font-family);
    background-color: var(--bg-dark);
    color: var(--text-primary);
    font-size: 13px;
}

#app-container {
    display: grid;
    grid-template-rows: 48px 1fr 240px;
    grid-template-columns: 240px 1fr 280px;
    grid-template-areas: 
        "toolbar toolbar toolbar"
        "left workspace right"
        "bottom bottom bottom";
    width: 100vw;
    height: 100vh;
}

/* Toolbar Styles */
.toolbar-panel {
    grid-area: toolbar;
    background-color: var(--bg-toolbar);
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    padding: 0 12px;
    gap: 16px;
}

.toolbar-group {
    display: flex;
    align-items: center;
    gap: 6px;
    border-right: 1px solid var(--border-color);
    padding-right: 16px;
}

.toolbar-group:last-child {
    border-right: none;
}

button {
    background-color: #333333;
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    padding: 6px 12px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 12px;
    transition: background 0.2s, border-color 0.2s;
}

button:hover:not(:disabled) {
    background-color: #3e3e42;
    border-color: var(--accent-color);
}

button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

button.success {
    background-color: #1b4725;
    border-color: #2ea043;
}
button.success:hover:not(:disabled) {
    background-color: #238636;
}

button.danger {
    background-color: #5a1d1d;
    border-color: #f85149;
}
button.danger:hover:not(:disabled) {
    background-color: #da3633;
}

.zoom-group span {
    font-size: 12px;
    color: var(--text-muted);
    min-width: 40px;
    text-align: center;
}

/* Sidebars & Panels */
.sidebar-left {
    grid-area: left;
    background-color: var(--bg-panel);
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
}

.sidebar-right {
    grid-area: right;
    background-color: var(--bg-panel);
    border-left: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
}

.sidebar-left h3, .sidebar-right h3 {
    padding: 10px 14px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-color);
}

.search-box {
    padding: 8px 12px;
    border-bottom: 1px solid var(--border-color);
}

.search-box input {
    width: 100%;
    background: var(--bg-dark);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 6px 10px;
    border-radius: 3px;
    outline: none;
}

.search-box input:focus {
    border-color: var(--accent-color);
}

.component-list-container {
    flex: 1;
    overflow-y: auto;
    padding: 8px;
}

.workspace-panel {
    grid-area: workspace;
    background-color: var(--bg-dark);
    position: relative;
    overflow: hidden;
}

#canvas-container {
    width: 100%;
    height: 100%;
    position: relative;
    cursor: grab;
}

#canvas-container:active {
    cursor: grabbing;
}

#circuit-canvas {
    display: block;
    width: 100%;
    height: 100%;
}

/* Bottom Panel */
.bottom-panel {
    grid-area: bottom;
    background-color: var(--bg-panel);
    border-top: 1px solid var(--border-color);
    display: grid;
    grid-template-columns: 1fr 1fr;
}

.editor-pane, .serial-pane {
    display: flex;
    flex-direction: column;
    height: 100%;
}

.editor-pane {
    border-right: 1px solid var(--border-color);
}

.pane-header {
    height: 32px;
    background-color: var(--bg-toolbar);
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    font-weight: 500;
    color: var(--text-muted);
}

.pane-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}

.pane-actions select {
    background: var(--bg-dark);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    padding: 3px 6px;
    border-radius: 3px;
    outline: none;
}

#code-editor-container {
    flex: 1;
    position: relative;
}

#code-editor {
    width: 100%;
    height: 100%;
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: none;
    padding: 10px;
    font-family: "Courier New", Courier, monospace;
    font-size: 13px;
    resize: none;
    outline: none;
    line-height: 1.5;
}

.serial-output {
    flex: 1;
    background-color: #1e1e1e;
    padding: 10px;
    font-family: "Courier New", Courier, monospace;
    font-size: 12px;
    overflow-y: auto;
    color: #ce9178;
}

.log-line {
    margin-bottom: 4px;
}

.log-line.system {
    color: #569cd6;
}

.placeholder-text {
    padding: 16px;
    color: var(--text-muted);
    font-style: italic;
}
