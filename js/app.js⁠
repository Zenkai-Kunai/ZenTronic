/**
 * app.js - Application entry point connecting components and UI state
 */
import { project } from './project.js';

document.addEventListener('DOMContentLoaded', () => {
    console.log("IoT Simulator initialized (Phase 1).");

    // Subscribe to project state updates to verify state flow
    project.subscribe((state) => {
        // console.log("State updated:", state);
    });

    // Wire up basic toolbar events
    const btnRun = document.getElementById('btn-run');
    const btnStop = document.getElementById('btn-stop');
    const btnPause = document.getElementById('btn-pause');

    btnRun.addEventListener('click', () => {
        btnRun.disabled = true;
        btnStop.disabled = false;
        btnPause.disabled = false;
        console.log("Simulation started...");
    });

    btnStop.addEventListener('click', () => {
        btnRun.disabled = false;
        btnStop.disabled = true;
        btnPause.disabled = true;
        console.log("Simulation stopped.");
    });

    btnPause.addEventListener('click', () => {
        console.log("Simulation paused.");
    });
});
